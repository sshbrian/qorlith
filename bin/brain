#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export QORLITH_ROOT="${QORLITH_ROOT:-${ROOT}}"
# shellcheck disable=SC1091
source "${ROOT}/bin/load-env"
PY="${ROOT}/brain/.venv/bin/python"
if [[ ! -x "${PY}" ]]; then
  PY="${PYTHON:-python3}"
fi
cd "${ROOT}"
exec "${PY}" -m brain "$@"
